<Application x:Class="ScanProcedure.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScanProcedure.ViewModels"
             xmlns:views="clr-namespace:ScanProcedure.Views"
             xmlns:local="clr-namespace:ScanProcedure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="x:Type vm:ScanProcedureViewModel">
                <views:ScanProcedureView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
