<Window x:Class="ScanProcedure.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScanProcedure"
        mc:Ignorable="d"
        Title="MainWindow" Height="640" Width="800"
        MinHeight="350" MinWidth="600">

    <Window.Resources>
        <!-- Centralized styles instead of repeating inline attributes -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="FontWeight" Value="bold"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style TargetType="RichTextBox">
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainPanel" Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColNav" Width="0"/>
            <ColumnDefinition x:Name="ColLeft" Width="3*"/>
            <ColumnDefinition x:Name="ColRight" Width="2*"/>
        </Grid.ColumnDefinitions>
        

        <!-- Top toolbar -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="5">
            <Button x:Name="BtnUploadMode" Content="Upload" Padding="10,2" Click="BtnUploadMode_Click" Visibility="Visible"/>
            <Button x:Name="BtnCopyMode" Content="Copy" Padding="10,2" Click="BtnCopyMode_Click" Visibility="Collapsed"/>
            <Label Content="DB Type :" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="8,0,8,0"/>
            <ComboBox x:Name="DbPicker" Margin="5"  VerticalAlignment="Center"  Text="Db Type">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        
        <!--#region Navigation Panel -->
        <Border x:Name="NavPanel" Visibility="Collapsed" Margin="5" Grid.Column="0" Grid.Row="1">
            <StackPanel Margin="5">
                <TextBlock Text="Navigation"/>
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Upload Panel -->
        <Border x:Name="UploadContainer" Visibility="Visible" Margin="15" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" Background="#EAEAEA" BorderBrush="#BDBDBD" BorderThickness="2" CornerRadius="6">
            <StackPanel Margin="5" HorizontalAlignment="center" VerticalAlignment="Center">
                <TextBlock Text="No file loaded yet" FontSize="14" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button x:Name="BtnSelectFile" Content="Select File to Upload" Padding="15,8" FontSize="13" Click="BtnSelectFile_Click"/>
            </StackPanel>
        </Border>
        <!--#endregion-->


        <!--#region Panel Kiri-->
        <Grid x:Name="LeftPanel" Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
            <RichTextBox x:Name="ScriptSQL" />
        </Grid>
        <!--#endregion-->

        <!--#region Panel Kanan-->
        <Grid x:Name="RightPanel" Visibility="Collapsed"  Grid.Row="1" Grid.Column="2" Margin="5" Background="#E0E0E0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                <Label Content="Read Table:" Style="{StaticResource StatLabel}"/>
                <Label x:Name="ReadTable" Content="0" Style="{StaticResource StatLabel}"/>
                <Label Content="Write Table:" Style="{StaticResource StatLabel}"/>
                <Label x:Name="WriteTable" Content="0" Style="{StaticResource StatLabel}"/>
                <Label Content="Calls:" Style="{StaticResource StatLabel}"/>
                <Label x:Name="Calls" Content="0" Style="{StaticResource StatLabel}"/>
            </StackPanel>

            <TextBlock x:Name="resultText"  Grid.Row="1" Margin="5" TextWrapping="Wrap"/>
        </Grid>
        <!--#endregion-->

        <!-- Bottom action bar -->
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnProcess" Content="Process" Click="BtnProcess_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="BtnCopy" Content="Copy To Clipboard" Click="BtnCopy_Click"/>
            <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
